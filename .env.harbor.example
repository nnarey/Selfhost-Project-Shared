# Set these in the Harbor Create App environment UI. Do not commit real values.
# Harbor itself sets PORT=8080.

ADMIN_PASSWORD=
# Trust SSO/Harbor identity headers so users land in their own account.
HARBOR_TRUST_IDENTITY=true
ADMIN_SESSION_HOURS=8
WEEK_TIMEZONE=America/Phoenix
# Open competition start (Phoenix calendar date). Scores and onboarding reset from this midnight.
COMPETITION_START=2026-08-31

# Point this at the Harbor EFS mount so SQLite and avatars survive restarts.
# Confirm the mount path in the Harbor wizard (often /mnt/efs or /data).
DATABASE_PATH=/data/fieldcam.sqlite

# Harbor must not call Fleet, Splunk, Slack, or Apps Script.
# Do not set SPLUNK_TOKEN. Activity CSV comes from git (data/).
FLEET_ENABLED=false
FLEET_MODE=off
FLEET_BASE_URL=
FLEET_CLIENT_ID=
FLEET_CLIENT_SECRET=
REMINDER_LIVE_ALLOWLIST=

# Checkout and permanent cameras both appear on Harbor. Evidence/Splunk/Slack stay off.
LEADERBOARD_PERMANENT_ONLY=false
