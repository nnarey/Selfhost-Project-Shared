# Copy to .env.local for local overrides. Do not commit secrets.

# Local Vite proxy expects 8787. Harbor sets PORT=8080.
PORT=8787
# Shared Admin password validated server-side (never expose via VITE_*).
ADMIN_PASSWORD=Password
# Session TTL in hours
ADMIN_SESSION_HOURS=8
# SQLite path (relative to server/)
DATABASE_PATH=data/fieldcam.sqlite
# GHA-committed Splunk CSV (Harbor image default /app/data/splunk-activity.csv).
# Do not set SPLUNK_TOKEN here or on Harbor.
# SPLUNK_SNAPSHOT_PATH=../data/splunk-activity.csv
# Default timezone for week boundaries
WEEK_TIMEZONE=America/Phoenix
COMPETITION_START=2026-08-31

# --- Northline Fleet Partner API (device ownership sync) ---
# Tracks who has which FieldCam over time so Splunk imports can attribute activity.
FLEET_ENABLED=true
# mock = local DB/demo ownership (no network)
# live = call Partner API
# off = disable sync
FLEET_MODE=mock
FLEET_BASE_URL=
# Optional override; default is {FLEET_BASE_URL}/api/oauth2/token
FLEET_TOKEN_URL=
FLEET_AGENCY_ID=
FLEET_CLIENT_ID=
FLEET_CLIENT_SECRET=
# Comma-separated Fleet model strings that count as a camera. Matched exactly, and a device
# with no model is skipped: the agency device list also returns docks and older cameras, and
# Fleet marks whoever registered one as its owner. Blank falls back to this default.
FLEET_DEVICE_MODEL=fieldcam_series
# Optional extra query, e.g. limit=500
FLEET_DEVICE_QUERY=
# How often to poll ownership (seconds). 300 = 5 minutes.
FLEET_POLL_SECONDS=300
# Optional JSON map when owner id is not email: {"owner-uuid":"user@northline.example"}
FLEET_OWNER_EMAIL_MAP={}

# Laptop: auto-sign in as this email (no app password). Ignored on Harbor.
# LOCAL_DEV_IDENTITY=alice@northline.example
HARBOR_TRUST_IDENTITY=false

# Reminder clocks run on Phoenix working time, not calendar time — a Friday-afternoon recording
# first becomes eligible on Tuesday afternoon rather than Monday morning.
REMINDER_IDLE_WORKING_HOURS=48
REMINDER_COOLDOWN_WORKING_HOURS=24

# Queue in Admin is the send confirmation. Empty allowlist = every queued recipient.
REMINDER_LIVE_ALLOWLIST=
# Send Slack DMs immediately when Admin queues (needs SLACK_BOT_TOKEN).
REMINDER_AUTO_SEND=true
SLACK_BOT_TOKEN=

# Laptop poller only. Harbor has no env-var UI; the daily GitHub Action uses Actions secrets instead.
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_SITE=issues.northline.example
JIRA_CLOUD_ID=00000000-0000-4000-8000-000000000001
JIRA_SELFHOST_EPIC=FC-100
JIRA_POLL_SECONDS=900
GOOGLE_API_KEY=
MECHANICAL_SHEET_ID=
