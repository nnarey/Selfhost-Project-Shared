# Copy to .env.local for local overrides. Restart Vite after changes.

# --- Local Node/SQLite API (server/) ---
# Browser talks to Vite proxy /local-api in dev. Point this at the local API.
# Harbor production build leaves this empty and uses same-origin /api.
VITE_LOCAL_API_URL=http://localhost:8787
# Server-side Admin password lives in server/.env.local as ADMIN_PASSWORD (not VITE_*).

# Shared password for legacy prototype admin login (bundled into JS — local demo only).
# Prefer the local API / future Apps Script server-side session.
VITE_ADMIN_PASSWORD=Password

# Deployed Google Apps Script web app URL (.../exec).
VITE_APPS_SCRIPT_URL=
# Public site URL used in onboarding/reminder copy (My Stats / Leaderboard links)
# VITE_STATS_SITE_URL=https://fieldcam.example

# --- If Workspace blocks "Anyone" (must stay "Anyone within Northline") ---
# Local Vite proxy needs your Google session cookie to call the web app.
# 1. In Chrome/Edge, open the Web app URL (?action=teams) while signed into Northline Google.
# 2. DevTools → Network → click the exec request → Request Headers → copy the full Cookie value.
#    Or: Application → Cookies → copy cookies for script.google.com / google.com as one Cookie header.
# 3. Paste below (server-only; do NOT use a VITE_ prefix). Never commit this.
# 4. Restart Vite. Cookies expire — refresh this when Sheets auth breaks again.
APPS_SCRIPT_COOKIE=

# --- Local Splunk diagnostic proxy only (Vite). Not ETL. Never set on Harbor. ---
# The sample activity CSV is written by scripts/etl_splunk_activity.py
# into data/splunk-activity.csv. Point SPLUNK_BASE_URL at a real Splunk only
# if you intentionally replace that mock.
# Restart `npm run dev` after changing these.
SPLUNK_BASE_URL=https://splunk.example:443
SPLUNK_TOKEN=
SPLUNK_EXPORT_PATH=/servicesNS/-/fieldcam-search/search/jobs/export
SPLUNK_AUTH_STYLE=Bearer
# Multi-line SPL lives in web/splunk-search.spl (not .env).
# SPLUNK_SEARCH_FILE=splunk-search.spl
